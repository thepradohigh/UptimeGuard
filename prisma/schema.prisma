generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Monitor {
  id        String     @id @default(cuid())
  name      String
  url       String
  method    String     @default("GET")
  interval  Int        @default(60) // В секундах
  status    String     @default("UP") // UP, DOWN, PAUSED
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  incidents Incident[]
  pings     Ping[]
}

model Incident {
  id         String    @id @default(cuid())
  monitorId  String
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status     String    @default("ACTIVE") // ACTIVE, RESOLVED
  cause      String?
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model Ping {
  id           String   @id @default(cuid())
  monitorId    String
  monitor      Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  responseTime Int      // В миллисекундах
  statusCode   Int?
  isUp         Boolean
  createdAt    DateTime @default(now())
}
