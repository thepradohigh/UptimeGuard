generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  name               String
  telegramChatId     String?   @map("telegram_chat_id")
  emailNotifications Boolean   @default(true) @map("email_notifications")
  notifyCooldown     Int       @default(5) @map("notify_cooldown")
  maxMonitors        Int       @default(50) @map("max_monitors")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  monitors           Monitor[]
  sessions           Session[]
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum MonitorStatus {
  UP
  DOWN
  TIMEOUT
  UNKNOWN
}

model Monitor {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  name           String
  url            String
  method         HttpMethod    @default(GET)
  expectedStatus Int           @default(200) @map("expected_status")
  headers        Json?         @db.JsonB
  body           String?
  interval       Int           @default(5)
  timeout        Int           @default(10)
  keyword        String?
  isActive       Boolean       @default(true) @map("is_active")
  lastStatus     MonitorStatus @default(UNKNOWN) @map("last_status")
  lastCheckedAt  DateTime?     @map("last_checked_at")
  lastNotifiedAt DateTime?     @map("last_notified_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks         Check[]
  incidents      Incident[]
  @@index([userId])
  @@index([isActive])
  @@index([lastCheckedAt])
  @@map("monitors")
}

model Check {
  id           String        @id @default(uuid()) @db.Uuid
  monitorId    String        @map("monitor_id") @db.Uuid
  status       MonitorStatus
  statusCode   Int?          @map("status_code")
  responseTime Int?          @map("response_time")
  errorMessage String?       @map("error_message")
  createdAt    DateTime      @default(now()) @map("created_at")
  monitor      Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  @@index([monitorId, createdAt])
  @@index([createdAt])
  @@map("checks")
}

model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  monitorId  String    @map("monitor_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at")
  resolvedAt DateTime? @map("resolved_at")
  duration   Int?
  cause      String?
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at")
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  @@index([monitorId])
  @@index([startedAt])
  @@map("incidents")
}